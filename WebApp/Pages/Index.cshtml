@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<div class="page-layout">
<!-- Left Sidebar Categories -->
<aside class="category-sidebar">
    <div class="category-header">Categories</div>
    <ul class="category-list">
        <li><a href="/Category/Automotive">Automotive <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Baby-Toddler">Baby & Toddler <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Beauty">Beauty <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Books">Books <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Cameras">Cameras <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Camping-Outdoors">Camping & Outdoors <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Cellphones-Wearables">Cellphones & Wearables <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Computers-Tablets">Computers & Tablets <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Diy-Tools">DIY Tools & Machinery <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Fashion">Fashion <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Gaming">Gaming <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Garden-Patio">Garden, Pool & Patio <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Health">Health <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Home-Kitchen">Home & Kitchen <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Household">Household, Food & Beverages <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Liquor">Liquor <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Luggage-Travel">Luggage & Travel <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Movies-Series">Movies & Series <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Music">Music <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Office-Stationery">Office & Stationery <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Pets">Pets <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Sport">Sport <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Tv-Audio-Video">TV, Audio & Video <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Toys">Toys <span class="arrow">&rarr;</span></a></li>
        <li><a href="/Category/Vouchers">Vouchers <span class="arrow">&rarr;</span></a></li>
    </ul>
</aside>

    <!-- Main Content Area -->
    <main class="main-content">
<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Welcome to Our Shop</h1>
        <p class="lead text-muted">Discover our featured products and curate your collection.</p>
    </div>

      <!-- 🔍 Search Bar Section (Matching Image Design) -->
    <div class="row justify-content-center mb-5">
        <div class="col-12 col-lg-10">
            <form method="get" asp-page-handler="Search">
                <div class="input-group shadow-sm">
                    <input type="text" 
                           name="searchQuery" 
                           class="form-control border-0 bg-light py-3 px-4" 
                           placeholder="Search for products, brands..." 
                           aria-label="Search for products, brands...">
                    <button class="btn btn-primary px-4 d-flex align-items-center" type="submit">
                        <!-- Standard Bootstrap Icon SVG or plain text symbol -->
                        <svg xmlns="http://w3.org" width="18" height="18" fill="currentColor" class="bi bi-search" viewBox="0 0 16 16">
                            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z"/>
                        </svg>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Product Grid -->
    <div class="row row-cols-1 row-cols-md-3 g-4">

        <!-- Product Card 1 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 position-relative">
                <img src="https://unsplash.com" class="card-img-top object-fit-cover" style="height: 250px;" alt="Running Shoes">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-semibold">Premium Running Shoes</h5>
                    <p class="card-text text-muted flex-grow-1">Lightweight, breathable, and designed for optimal support during long runs.</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-4 fw-bold text-dark">$129.99</span>
                        <span class="badge bg-success">In Stock</span>
                    </div>
                    <div class="d-grid gap-2">
                        <form method="post" asp-page-handler="AddToCart" asp-route-productId="1">
                            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                                🛒 Add to Cart
                            </button>
                        </form>
                        <form method="post" asp-page-handler="AddToWishlist" asp-route-productId="1">
                            <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                                ❤️ Wishlist
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Card 2 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 position-relative">
                <img src="https://unsplash.com" class="card-img-top object-fit-cover" style="height: 250px;" alt="Wireless Headphones">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-semibold">Wireless Headphones</h5>
                    <p class="card-text text-muted flex-grow-1">Immersive sound quality with advanced active noise-cancelling technology.</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-4 fw-bold text-dark">$199.99</span>
                        <span class="badge bg-success">In Stock</span>
                    </div>
                    <div class="d-grid gap-2">
                        <form method="post" asp-page-handler="AddToCart" asp-route-productId="2">
                            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                                🛒 Add to Cart
                            </button>
                        </form>
                        <form method="post" asp-page-handler="AddToWishlist" asp-route-productId="2">
                            <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                                ❤️ Wishlist
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Card 3 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0 position-relative">
                <img src="https://unsplash.com" class="card-img-top object-fit-cover" style="height: 250px;" alt="Minimalist Watch">
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title fw-semibold">Minimalist Smart Watch</h5>
                    <p class="card-text text-muted flex-grow-1">Sleek, modern timepiece featuring complete health tracking and seamless alerts.</p>
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fs-4 fw-bold text-dark">$249.99</span>
                        <span class="badge bg-warning text-dark">Low Stock</span>
                    </div>
                    <div class="d-grid gap-2">
                        <form method="post" asp-page-handler="AddToCart" asp-route-productId="3">
                            <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2">
                                🛒 Add to Cart
                            </button>
                        </form>
                        <form method="post" asp-page-handler="AddToWishlist" asp-route-productId="3">
                            <button type="submit" class="btn btn-outline-danger w-100 d-flex align-items-center justify-content-center gap-2">
                                ❤️ Wishlist
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

    </div>
        </div>
    </main>
</div>