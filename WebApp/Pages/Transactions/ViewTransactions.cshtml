@page
@model WebAppAuthentication.Pages.Transactions.ViewTransactionsModel
@{}
<div class="container border rounded shadow-sm bg-white" style="padding:20px; margin-top:20px;">
    <!-- Top Action Flexbox Header Row -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="m-0 text-dark fw-bold">📊 Transactions </h3>

        <div class="d-flex align-items-center gap-3">
            <a href="javascript:history.back()" class="text-secondary text-decoration-none d-inline-flex align-items-center gap-1 small fw-semibold" title="Go Back">
                <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-short" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M12 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5a.5.5 0 0 1 .5.5" />
                </svg>
                Back
            </a>
            <div class="vr text-muted" style="height: 18px;"></div>
            <a href="/" class="text-danger text-decoration-none d-inline-flex align-items-center gap-1 small fw-semibold" title="Close Profile">
                <svg xmlns="http://w3.org" width="14" height="14" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                    <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                </svg>
                Close
            </a>
        </div>
    </div>

    <!-- Unified Filters & Action Form -->
    <form method="post" class="mb-4">
        <div class="text-danger" asp-validation-summary="All"></div>
         
        <!-- TRANSACTION FILTERS ROW -->
        <div class="row g-3 align-items-end mb-4 bg-light p-3 rounded border">
             @{
                // Calculate today's date formatted as YYYY-MM-DD for the HTML max attribute
                string maxDateToday = DateTime.Today.ToString("yyyy-MM-dd");
            }
            <div class="col-12 d-none" id="dateValidationError">
                <div class="alert alert-danger py-2 px-3 small d-flex align-items-center gap-2 m-0 shadow-sm">
                    <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-exclamation-triangle-fill flex-shrink-0" viewBox="0 0 16 16">
                        <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5m.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                    </svg>
                    <span id="validationErrorText">End Date cannot be less than Start Date.</span>
                </div>
            </div>
            <div class="col-md-3">
                <label asp-for="StartDate" class="form-label small fw-bold text-secondary">Start Date</label>
                <input type="date" asp-for="StartDate" id="filterStartDate" max="@maxDateToday" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label asp-for="EndDate" class="form-label small fw-bold text-secondary">End Date</label>
                <input type="date" asp-for="EndDate" id="filterEndDate" max="@maxDateToday" class="form-control form-control-sm" />
            </div>
             
            <div class="col-md-3">
                <label asp-for="TransactionType" class="form-label small fw-bold text-secondary">Type</label>
                <select asp-for="TransactionType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="Deposit">Deposit</option>
                    <option value="Withdrawal">Withdrawal</option>
                    <option value="Transfer">Transfer</option>
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <!-- Added a hidden field to default page changes when clicking Search vs Page buttons -->
                <input type="hidden" name="IsSearchTrigger" id="IsSearchTrigger" value="false" />
                 <button type="submit" id="btnGetTransactions" class="btn btn-secondary btn-sm shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
                    <span id="btnIcon">🔍</span>
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                    <span id="btnText">Get Transactions</span>
                </button>
            </div>
        </div>

        <!-- Execution Metrics Banner -->
        @if (Model.Transactions != null)
        {
            <div class="alert alert-info py-2 px-3 small d-flex justify-content-between align-items-center shadow-xs mb-3">
                <span>Query Runtime: <strong class="text-success">@Model.ExecutionTimeMs ms</strong></span>
            </div>

            <!-- Records Table Grid -->
            <div class="table-responsive border rounded mb-3">
                <table class="table table-striped table-hover m-0 align-middle small">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Reference</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-center" style="width: 100px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Transactions.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No transactional data matches your filters.</td>
                            </tr>
                        }
                        @foreach (var item in Model.Transactions)
                        {
                            <tr>
                                <td>@item.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                                <td>@item.Reference</td>
                                <td>
                                    <span class="badge @(item.Type == "Deposit" ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                                        @item.Type
                                    </span>
                                </td>
                                <td class="text-end fw-bold text-dark">@item.Amount.ToString("C")</td> 
                                <td class="text-center">
@*                                     <!-- Changed from link to a button triggering a JavaScript fetch function --> *@
                                    <button type="button" 
                                            class="btn btn-outline-primary btn-xs py-1 px-2 d-inline-flex align-items-center gap-1 shadow-sm font-monospace small" 
                                            style="font-size: 0.75rem;" 
                                            title="View Details"
                                            onclick="openTransactionDetails('@item.Id')">
                                        <svg xmlns="http://w3.org" width="12" height="12" fill="currentColor" class="bi bi-eye-fill" viewBox="0 0 16 16">
                                            <path d="M10.5 8a2.5 2.5 0 1 1-5 0 2.5 2.5 0 0 1 5 0z" />
                                            <path d="M0 8s3-5.5 8-5.5 8 5.5 8 5.5-3 5.5-8 5.5S0 8S0 8zm8 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                                        </svg>
                                        View
                                    </button>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Dynamic Pagination Control Blocks (Now correctly nested inside form boundaries) --> 
            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Transaction table pagination">
                    <ul class="pagination pagination-sm justify-content-end m-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <button type="submit" name="CurrentPage" value="@(Model.CurrentPage - 1)" class="page-link" @(!Model.HasPreviousPage ? "disabled" : "")>Previous</button>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <button type="submit" name="CurrentPage" value="@i" class="page-link">@i</button>
                            </li>
                        }

                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <button type="submit" name="CurrentPage" value="@(Model.CurrentPage + 1)" class="page-link" @(!Model.HasNextPage ? "disabled" : "")>Next</button>
                        </li>
                    </ul>
                </nav>
            } 
        }
    </form>
</div>
 
<!-- Bootstrap Transaction Details Modal Layout -->
<div class="modal fade" id="transactionDetailsModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header bg-light">
                <h5 class="modal-title fw-bold text-dark" id="modalTitle">🧾 Transaction Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalLoaderContent">
                <!-- Loading Spinner State Indicator -->
                <div id="modalSpinner" class="d-flex justify-content-center align-items-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
                
                <!-- Details Context Content View (Hidden Initially) -->
                <div id="modalDataContainer" class="d-none">
                    <div class="row g-3">
                        <div class="col-12 border-bottom pb-2">
                            <span class="text-uppercase text-muted fw-bold small d-block">Transaction ID</span>
                            <span id="id" class="font-monospace text-secondary small fw-medium"></span>
                        </div>
                        <div class="col-6">
                            <span class="text-uppercase text-muted fw-bold small d-block">Execution Date</span>
                            <span id="transactionDate" class="text-dark fw-semibold"></span>
                        </div>
                        <div class="col-6">
                            <span class="text-uppercase text-muted fw-bold small d-block">Transfer Type</span>
                            <span id="transactionType" class="badge"></span>
                        </div>
                        <div class="col-12 bg-light p-3 border rounded">
                            <span class="text-uppercase text-muted fw-bold small d-block mb-1">Reference / Description</span>
                            <span id="description" class="text-dark fw-medium"></span>
                        </div>
                        <div class="col-12 text-end mt-4">
                            <span class="text-uppercase text-muted fw-bold small d-block mb-1">Settled Amount</span>
                            <h3 id="amount" class="m-0 fw-bold text-dark"></h3>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm px-4" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script> 
        // Global function context definition
    function openTransactionDetails(transactionId) {
    // 1. Initialize Bootstrap Modal context instance variables 
    var modalElement = document.getElementById('transactionDetailsModal');
    var bootstrapModal = bootstrap.Modal.getOrCreateInstance(modalElement);
    
    var spinner = document.getElementById('modalSpinner');
    var dataContainer = document.getElementById('modalDataContainer');
    
    // Show loading spinner states cleanly before the fetch hits the backend pipeline
    spinner.classList.remove('d-none');
    dataContainer.classList.add('d-none');
    
    // Open the popup window view container
    bootstrapModal.show();

    // 2. Fetch data from your backend handler via an AJAX endpoint layout call
    // Note: This endpoint should route cleanly back into your PageModel handler or direct service proxy pipelines
    fetch(`?handler=TransactionDetailJson&id=${transactionId}`)
        .then(response => {
            if (!response.Ok && response.status !== 200) {
                throw new Error("Unable to parse transaction registry metadata layers.");
            }
            return response.json();
        })
        .then(data => {
            // Unpack JSON string if returned as raw internal response text block fields
            if (typeof data === 'string') {
                data = JSON.parse(data);
            }

            var entity = data.transactionEntity || data;

            // 3. Map retrieved attributes seamlessly into HTML placeholder objects
            document.getElementById('id').textContent = entity.id || transactionId;
            document.getElementById('transactionDate').textContent = entity.transactionDate ? entity.transactionDate.replace('T', ' ') : 'N/A';
            document.getElementById('description').textContent = entity.description || 'No summary specified.';
            
            // Format Currency display values cleanly using local currency formatting profiles
            var amountFormatted = new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(entity.amount || 0);
            document.getElementById('amount').textContent = amountFormatted;

            // Apply conditional CSS badge color code parameters depending on item type strings
            var typeBadge = document.getElementById('transactionType');
            typeBadge.textContent = entity.transactionType || 'Unknown';
            typeBadge.className = "badge " + (entity.transactionType === 'Deposit' || entity.transactionType === 'Credit' 
                ? 'bg-success-subtle text-success border border-success' 
                : 'bg-danger-subtle text-danger border border-danger');

            // Toggle layout element visibilities seamlessly
            spinner.classList.add('d-none');
            dataContainer.classList.remove('d-none');
        })
        .catch(error => {
            console.error("Popup details initialization exception error:", error);
            document.getElementById('id').textContent = "Failed to load transaction data details. Please close and try again later.";
            spinner.classList.add('d-none');
            dataContainer.classList.remove('d-none');
        });
}
    </script>
 <script> 
            // 2. Click Validation Interceptor Logic
            var btnGetTransactions = document.getElementById("btnGetTransactions");
            var startDateInput = document.getElementById("filterStartDate");
            var endDateInput = document.getElementById("filterEndDate");
            var errorAlert = document.getElementById("dateValidationError");
            var errorText = document.getElementById("validationErrorText");

             // Spinner elements reference bindings
            var btnIcon = document.getElementById("btnIcon");
            var btnSpinner = document.getElementById("btnSpinner");
            var btnText = document.getElementById("btnText");

            btnGetTransactions.addEventListener("click", function (event) {
                // Reset validation visibility state
                errorAlert.classList.add("d-none");

                var startVal = startDateInput.value;
                var endVal = endDateInput.value;

                if (startVal && endVal) {
                    var startDate = new Date(startVal);
                    var endDate = new Date(endVal);

                    // Check if End Date is before Start Date
                    if (endDate < startDate) {
                        event.preventDefault(); // Stop form post submission to server
                        errorText.textContent = "Validation Error: End Date cannot be earlier than the chosen Start Date.";
                        errorAlert.classList.remove("d-none"); // Show Bootstrap alert panel
                        return false;
                    }
                }
                 // --- Trigger Waiting Spinner Activation States ---
                btnIcon.classList.add("d-none");          // Hide magnifying glass icon
                btnSpinner.classList.remove("d-none");    // Show spinner loader instance
                btnText.textContent = "Loading...";       // Change active text string label
                btnGetTransactions.classList.add("disabled"); // Prevent accidental multi-clicks
            });
        });
    </script>
}