@if (User is not null && User.Identity is not null && User.Identity.IsAuthenticated)
{
    <form method="post" class="form-check-inline" asp-page="/Account/Logout">
        Welcome:  @User.Identity.Name (@User.Claims.First(c => c.Type == "Designation").Value)
        <button type="submit" class="ml-2 btn btn-link">Logout</button>
    </form>
    <form method="get" class="form-check-inline" asp-page="/Account/UserLoginActivities/ChangePassword"> 
        <input type="hidden" name="Email" value="@User.Identity.Name" />
        <button type="submit" class="ml-2 btn btn-link">Change Password</button>
    </form>
    <form method="get" class="form-check-inline" asp-page="/Account/UserProfile"> 
        <input type="hidden" name="Email" value="@User.Identity.Name" />
        <button type="submit" class="ml-2 btn btn-link">View Profile</button>
    </form>
}
else
{
    <a class="btn btn-link" asp-page="Account/Login">Login</a>
}