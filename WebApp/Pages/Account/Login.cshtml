
@page
@model WebApp.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
    Layout = null; // Bypasses the default site layout for a clean, focused login page
}
 

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YourAppName</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h2>Welcome Back</h2>
                <p>Please enter your details to sign in</p>
            </div>

            <form id="account" method="post">
                <!-- Server-Side Validation Summary -->
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <!-- Email / Username Input Group -->
                <div class="input-group">
                    <label asp-for="Credential.Email">Email Address</label>
                    <input asp-for="Credential.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                    <span asp-validation-for="Credential.Email" class="text-danger"></span>
                </div>

                <!-- Password Input Group -->
                <div class="input-group">
                    <div class="label-wrapper">
                        <label asp-for="Credential.Password">Password</label>
                        <a id="forgot-password" asp-page="./UserLoginActivities/ForgotPassword" class="forgot-link">Forgot password?</a>
                    </div>
                    <input asp-for="Credential.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="••••••••" />
                    <span asp-validation-for="Credential.Password" class="text-danger"></span>
                </div>

                <!-- Remember Me & Checkbox -->
                <div class="form-actions">
                    <label asp-for="Credential.RememberMe" class="checkbox-label">
                        <input class="form-checkbox" asp-for="Credential.RememberMe" />
                        @Html.DisplayNameFor(m => m.Credential.RememberMe)
                    </label>
                </div>

                <!-- Submit Button -->
                <button id="login-submit" type="submit" class="btn-submit">Sign In</button>
            </form>

            <div class="login-footer">
                <p>Don't have an account? <a asp-page="/Account/Register" asp-route-returnUrl="@Model.ReturnUrl">Sign up here</a></p>
            </div>
        </div>
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }


</body>
</html>

 