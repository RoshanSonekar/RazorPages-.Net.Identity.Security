@page
@model WebAppAuthentication.Pages.Account.UserLoginActivities.ResetPasswordConfirmationModel
@{
}

@if (Model.IsPasswordResetSuccessful)
{
    <h3>
        Your password has been reset successfully. You can now <a href="/Account/Login">login</a> with your new password.
    </h3>
}
else
{
    <h3>
        Password reset failed. Please ensure that the reset link is valid and has not expired. If you continue to experience issues, please contact support.
    </h3>
} 