@page
@model WebAppAuthentication.Pages.Account.UserLoginActivities.ChangePasswordModel
@{
}

<h3>Change Password</h3>
<div class="container border" style="padding:20px">
    <!-- Top Action Flexbox Header Row -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="m-0">User Profile</h3>

        <div class="d-flex align-items-center gap-3">
            <a href="javascript:history.back()" class="text-secondary text-decoration-none d-inline-flex align-items-center gap-1 small fw-semibold" title="Go Back">
                <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-short" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M12 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5a.5.5 0 0 1 .5.5" />
                </svg>
                Back
            </a>
            <div class="vr text-muted" style="height: 18px;"></div>
            <a href="/" class="text-danger text-decoration-none d-inline-flex align-items-center gap-1 small fw-semibold" title="Close Profile">
                <svg xmlns="http://w3.org" width="14" height="14" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                    <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                </svg>
                Close
            </a>
        </div>
    </div>
    <form method="post">
        <div class="text-danger" asp-validation-summary="All"></div> 

        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="changePasswordViewModel.CurrentPassword">   </label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="changePasswordViewModel.CurrentPassword" class="form-control" />
                <span class="text-danger" asp-validation-for="changePasswordViewModel.CurrentPassword"> </span>
            </div>
        </div>

        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="changePasswordViewModel.NewPassword">   </label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="changePasswordViewModel.NewPassword" class="form-control" />
                <span class="text-danger" asp-validation-for="changePasswordViewModel.NewPassword"> </span>
            </div>
        </div>

        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="changePasswordViewModel.ConfirmNewPassword">   </label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="changePasswordViewModel.ConfirmNewPassword" class="form-control" />
                <span class="text-danger" asp-validation-for="changePasswordViewModel.ConfirmNewPassword"> </span>
            </div>
        </div>
         
        <div class="col">
            <input type="hidden" asp-for="@Model.Email" /> 
        </div>

        <div class="mb-3 row"> 
            <div class="col-2"></div>

            <!-- Action elements aligned under the input fields -->
            <div class="col-5 d-flex align-items-center gap-3">
                <input type="submit" id="btnChangePassword"  class="btn btn-primary px-4 shadow-sm" value="Change Password" />
                <a class="btn btn-link" href="/Account/UserLoginActivities/ForgotPassword">Forgot Password ?</a>
            </div>
        </div>
    </form>
</div>