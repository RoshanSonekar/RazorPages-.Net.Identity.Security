@page
@model WebAppAuthentication.Pages.Account.UserLoginActivities.ForgotPasswordModel
@{
}

<h3>Forgot Password</h3>
<div class="container border" style="padding:20px">
    <form method="post">
        <!-- Fallback/Other Validation Summary (e.g., Lockout messages) -->
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert" style="color: #dc3545; font-size: 0.9rem;"></div>
        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="forgotPasswordViewModel.Email">   </label>
            </div>
            <div class="col-5">
                <input type="text" asp-for="forgotPasswordViewModel.Email" class="form-control" />
                <span class="text-danger" asp-validation-for="forgotPasswordViewModel.Email"> </span>
            </div>
        </div>

        <div class="mb-3 row">
            <div class="col-2"></div>
            <!-- Action elements aligned under the input fields -->
            <div class="col-5 d-flex align-items-center gap-3">
                <input type="submit" id="btnForgotPassword" class="btn btn-primary px-4 shadow-sm" value="Send Reset Link" />
                <a class="btn btn-link" href="/Account/Register">Sign-Up</a>
                <a class="btn btn-link" href="/Account/UserLoginActivities/ForgotPassword">Forgot Password ?</a>
            </div>
        </div> 
    </form>
</div>