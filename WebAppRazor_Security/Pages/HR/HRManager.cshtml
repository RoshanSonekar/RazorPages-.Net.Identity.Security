@page
@model WebAppRazor_Security.Pages.HR.HRManagerModel
@{
}


<div class="text-center">
    <h1 class="display-4">Welcome Welcome To The HR Manager Page</h1> 
</div>

@if (Model.dTOWeatherForcastsItems is not null)
{
    <ul>
      @*   @foreach (var item in Model.dTOWeatherForcastsItems)
        {
            <li>@item.Date.ToShortDateString() - @item.TemperatureC.ToString() - @item.Summary </li>
        } *@
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Temperature C</th>
                    <th>Temperature F</th>
                    <th>Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.dTOWeatherForcastsItems)
                {
                    <tr>
                        <td>@item.Date.ToShortDateString()</td>   
                        <td>@item.TemperatureC</td>   
                        <td>@item.TemperatureF</td>  
                        <td>@item.Summary</td>
                    </tr>
                }
            </tbody>
        </table>

    </ul>
}