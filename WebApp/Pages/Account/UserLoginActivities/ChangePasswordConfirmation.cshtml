@page
@model WebAppAuthentication.Pages.Account.UserLoginActivities.ChangePasswordConfirmationModel
@{
}

@if (Model.IsSuccess)
{
    <h3>Password Changed Successfully</h3>
    <p>Your password has been changed successfully. You can now log in with your new password.</p>
    <a class="btn btn-primary" href="/Account/Login">Go to Login</a>
}
else
{
    <h3>Password Change Failed</h3>
    <p>There was an error changing your password. Please try again.</p>
    <a class="btn btn-primary" href="/Account/UserLoginActivities/ChangePassword">Try Again</a>
}