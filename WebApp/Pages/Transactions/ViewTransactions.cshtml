@page
@model WebAppAuthentication.Pages.Transactions.ViewTransactionsModel
    ViewData["Title"] = "Transactions";
}

<div class="container border rounded shadow-sm bg-white" style="padding:20px; margin-top:20px;">
    <!-- Top Action Flexbox Header Row -->
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="m-0 text-dark fw-bold">📊 Transactions Benchmark</h3>

        <div class="d-flex align-items-center gap-3">
            <a href="javascript:history.back()" class="text-secondary text-decoration-none d-inline-flex align-items-center gap-1 small fw-semibold" title="Go Back">
                <svg xmlns="http://w3.org" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-short" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M12 8a.5.5 0 0 1-.5.5H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5H11.5a.5.5 0 0 1 .5.5" />
                </svg>
                Back
            </a>
            <div class="vr text-muted" style="height: 18px;"></div>
            <a href="/" class="text-danger text-decoration-none d-inline-flex align-items-center gap-1 small fw-semibold" title="Close Profile">
                <svg xmlns="http://w3.org" width="14" height="14" fill="currentColor" class="bi bi-x-lg" viewBox="0 0 16 16">
                    <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z" />
                </svg>
                Close
            </a>
        </div>
    </div>

    <!-- Unified Filters & Action Form -->
    <form method="get" class="mb-4">
        <div class="text-danger" asp-validation-summary="All"></div>
        <input type="hidden" asp-for="Email" />
 <div class="p-3 mb-4 bg-light border rounded position-relative">
    
   <!-- Bootstrap Toast Container Layout Element -->
    <div class="toast-container position-absolute top-0 end-0 p-3" style="z-index: 1055;">
        <div id="stackLockToast" class="toast align-items-center text-white bg-success border-0 shadow" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center gap-2 small fw-medium">
                    <i class="bi bi-check-circle-fill fs-6"></i>
                    Target architecture stack configuration locked successfully!
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
        </div>
    </div>

    <!-- Header Control Strip -->
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <div class="d-flex align-items-center gap-2">
            <h6 class="text-uppercase text-muted fw-bold small m-0">Target Stack Configuration</h6>
            <!-- Conditional Active/Locked Confirmation Badges -->
            @if (Model.IsStackLocked)
            {
                <span class="badge bg-success-subtle text-success border border-success px-2 py-1 rounded-pill small d-inline-flex align-items-center gap-1">
                    <i class="bi bi-lock-fill"></i> Locked
                </span>
            }
            else
            {
                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1 rounded-pill small d-inline-flex align-items-center gap-1">
                    <i class="bi bi-unlock-fill"></i> Unlocked
                </span>
            }
        </div>
        
        <!-- Dynamic State Toggle Action Button -->
        @if (Model.IsStackLocked)
        {
            <button type="submit" name="Action" value="UnlockStack" id="btnUnlockStack" class="btn btn-outline-secondary btn-sm px-4 shadow-sm fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-unlock-fill"></i> Unlock Provider and ORM
            </button>
        }
        else
        {
            <button type="submit" name="Action" value="LockStack" id="btnLockStack" class="btn bg-info-subtle text-info-emphasis border-info btn-sm px-4 shadow-sm fw-semibold d-inline-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-lock-fill"></i> Lock Provider and ORM
            </button>
        }
    </div>
    
    <div class="row g-4">
        <!-- Database Provider Radio Group -->
        <div class="col-xl-6">
            <label class="form-label small fw-bold text-secondary d-block mb-2">1. Target Database Provider</label>
            <div class="d-flex flex-column gap-2 shadow-xs p-2 bg-white rounded border">
                <div class="form-check m-0 px-5 py-1">
                    <input type="radio" class="form-check-input" name="SelectedDb" id="dbSqlServer" value="SqlServer" 
                           @(Model.SelectedDb == "SqlServer" ? "checked" : "") @(Model.IsStackLocked ? "disabled" : "onchange=this.form.submit();")>
                    <label class="form-check-label text-dark small" for="dbSqlServer">
                        <i class="bi bi-database-fill me-1 text-secondary"></i> SQL Server
                    </label>
                </div>
                <div class="form-check m-0 px-5 py-1">
                    <input type="radio" class="form-check-input" name="SelectedDb" id="dbPostgreSql" value="PostgreSql" 
                           @(Model.SelectedDb == "PostgreSql" ? "checked" : "") @(Model.IsStackLocked ? "disabled" : "onchange=this.form.submit();")>
                    <label class="form-check-label text-dark small" for="dbPostgreSql">
                        <i class="bi bi-database me-1 text-primary"></i> PostgreSQL
                    </label>
                </div>
                <div class="form-check m-0 px-5 py-1">
                    <input type="radio" class="form-check-input" name="SelectedDb" id="dbMongoDb" value="MongoDb" 
                           @(Model.SelectedDb == "MongoDb" ? "checked" : "") @(Model.IsStackLocked ? "disabled" : "onchange=this.form.submit();")>
                    <label class="form-check-label text-dark small" for="dbMongoDb">
                        <i class="bi bi-leaf-fill me-1 text-success"></i> MongoDB
                    </label>
                </div>
            </div>
        </div>

        <!-- ORM Strategy Radio Group -->
        <div class="col-xl-6">
            <label class="form-label small fw-bold text-secondary d-block mb-2">2. Access Driver / ORM Framework</label>
            <div class="d-flex flex-column gap-2 shadow-xs p-2 bg-white rounded border">
                <div class="form-check m-0 px-5 py-1">
                    <input type="radio" class="form-check-input" name="SelectedOrm" id="ormEfCore" value="EFCore" 
                           @(Model.SelectedOrm == "EFCore" ? "checked" : "") @(Model.IsStackLocked ? "disabled" : "")>
                    <label class="form-check-label text-dark small" for="ormEfCore">
                        <i class="bi bi-lightning-charge-fill me-1 text-warning"></i> EF Core
                    </label>
                </div>
                <div class="form-check m-0 px-5 py-1">
                    <input type="radio" class="form-check-input" name="SelectedOrm" id="ormDapper" value="Dapper" 
                           @(Model.SelectedOrm == "Dapper" ? "checked" : "") @(Model.IsStackLocked ? "disabled" : "")>
                    <label class="form-check-label text-dark small" for="ormDapper">
                        <i class="bi bi-speedometer me-1 text-danger"></i> Dapper
                    </label>
                </div>
                <div class="form-check m-0 px-5 py-1 @(Model.SelectedDb != "PostgreSql" || Model.IsStackLocked ? "opacity-50" : "")">
                    <input type="radio" class="form-check-input" name="SelectedOrm" id="ormMarten" value="Marten" 
                           @(Model.SelectedOrm == "Marten" ? "checked" : "") 
                           @(Model.SelectedDb != "PostgreSql" || Model.IsStackLocked ? "disabled" : "")>
                    <label class="form-check-label text-dark small" for="ormMarten" 
                           title="@(Model.SelectedDb != "PostgreSql" ? "Marten requires PostgreSQL" : "")">
                        <i class="bi bi-feather me-1 text-info"></i> Marten
                    </label>
                </div>
            </div>
        </div>
    </div>
</div>


        <!-- TRANSACTION FILTERS ROW -->
        <div class="row g-3 align-items-end mb-4 bg-light p-3 rounded border">
            <div class="col-md-3">
                <label asp-for="StartDate" class="form-label small fw-bold text-secondary">Start Date</label>
                <input type="date" asp-for="StartDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label asp-for="EndDate" class="form-label small fw-bold text-secondary">End Date</label>
                <input type="date" asp-for="EndDate" class="form-control form-control-sm" />
            </div>
            <div class="col-md-3">
                <label asp-for="TransactionType" class="form-label small fw-bold text-secondary">Type</label>
                <select asp-for="TransactionType" class="form-select form-select-sm">
                    <option value="">All Types</option>
                    <option value="Deposit">Deposit</option>
                    <option value="Withdrawal">Withdrawal</option>
                    <option value="Transfer">Transfer</option>
                </select>
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-secondary btn-sm shadow-sm">
                    🔍 Filter Records
                </button>
            </div>
        </div>
    </form>

    <!-- Execution Metrics Banner -->
    @if (Model.Transactions != null)
    {
        <div class="alert alert-info py-2 px-3 small d-flex justify-content-between align-items-center shadow-xs mb-3">
            <span>Stack: <span class="badge bg-dark">@Model.SelectedDb</span> + <span class="badge bg-primary">@Model.SelectedOrm</span></span>
            <span>Query Runtime: <strong class="text-success">@Model.ExecutionTimeMs ms</strong></span>
        </div>

        <!-- Records Table Grid -->
        <div class="table-responsive border rounded mb-3">
            <table class="table table-striped table-hover m-0 align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Date</th>
                        <th>Reference</th>
                        <th>Type</th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Transactions.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No transactional data matches your filters.</td>
                        </tr>
                    }
                    @foreach (var item in Model.Transactions)
                    {
                        <tr>
                            <td class="fw-medium text-secondary">#@item.Id</td>
                            <td>@item.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@item.Reference</td>
                            <td>
                                <span class="badge @(item.Type == "Deposit" ? "bg-success-subtle text-success border border-success" : "bg-danger-subtle text-danger border border-danger")">
                                    @item.Type
                                </span>
                            </td>
                            <td class="text-end fw-bold text-dark">@item.Amount.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Dynamic Pagination Control Blocks -->
        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Transaction table pagination">
                <ul class="pagination pagination-sm justify-content-end m-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" asp-all-route-data="@Model.GetRouteData(Model.CurrentPage - 1)">Previous</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-all-route-data="@Model.GetRouteData(i)">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" asp-all-route-data="@Model.GetRouteData(Model.CurrentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
</div>

                        @section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Check if the lock state was just processed on the server-side
            var isLocked = '@Model.IsStackLocked'.toLowerCase() === 'true';
            
            if (isLocked) { 
                var toastEl = document.getElementById('stackLockToast');
                if (toastEl) {
                    var toast = new bootstrap.Toast(toastEl, { delay: 4000 });
                    toast.show();
                }
            }
        });
    </script>
}