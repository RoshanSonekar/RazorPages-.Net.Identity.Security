@page
@model WebAppAuthentication.Pages.Account.UserLoginActivities.ResetPasswordModel
@{
}


<h3>Reset Password</h3>
<p>
    <h3>Please enter the new password to reset.</h3>
</p>
<div class="container border" style="padding:20px">
    <form method="post">
        <div class="text-danger" asp-validation-summary="All"></div>  

        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="resetPasswordViewModel.Password">   </label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="resetPasswordViewModel.Password" class="form-control" />
                <span class="text-danger" asp-validation-for="resetPasswordViewModel.Password"> </span>
            </div>
        </div>

        <div class="mb-3 row">
            <div class="col-2">
                <label asp-for="resetPasswordViewModel.ConfirmPassword">   </label>
            </div>
            <div class="col-5">
                <input type="password" asp-for="resetPasswordViewModel.ConfirmPassword" class="form-control" />
                <span class="text-danger" asp-validation-for="resetPasswordViewModel.ConfirmPassword"> </span>
            </div>
        </div>
        <div class="col">
            <input type="hidden" asp-for="resetPasswordViewModel.UserId" />
            <input type="hidden" asp-for="resetPasswordViewModel.Token" />
        </div>

        <div class="mb-3 row">
            <div class="col-2">
                <input type="submit" class="btn btn-primary" value="Reset Password" />
            </div>
            <div class="col-5">
                <a class="btn btn-link" href="/Account/Register">Sign-Up</a>
                <a class="btn btn-link" href="/Account/UserLoginActivities/ForgotPassword">Forgot Password ?</a>
            </div>
        </div>
    </form>
</div>